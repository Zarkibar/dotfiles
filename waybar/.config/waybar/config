{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": ["hyprland/workspaces", "tray", "custom/screenrecord"],
  "modules-center": ["clock", "custom/power"],
  "modules-right": ["custom/bluetooth", "pulseaudio", "network", "cpu", "memory", "custom/notification"],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },

  "tray": {
      "icon-size": 20,
      "spacing": 10
  },

  "custom/screenrecord": {
      "exec": "~/.config/waybar/scripts/screenrecord.sh",
      "return-type": "json",
      "interval": 1,
      "format": "{text}",
      "tooltip": true,
      "on-click": "killall wf-recorder"
  },

  "custom/notification": {
    "format": "󰂚",
    "tooltip": false,
    "on-click": "qs -p ~/.config/quickshell/Notifications.qml ipc call notifications toggle"
  },

  "custom/power": {
      "format": "⏻",
      "tooltip": false,
      "on-click": "sh ~/.config/hypr/scripts/power-menu.sh",
      "interval": 0
  },

  "clock": {
    "format": "{:%A, %d %B %Y, %I:%M %p}",
    "tooltip-format": "{:%A, %d %B %Y}",
    "format-alt": "  {:%I:%M %p}"
  },

  "custom/bluetooth": {
    "format": " {}",
    "exec": "~/.config/waybar/scripts/bluetooth.sh",
    "interval": 5,
    "on-click": "blueman-manager",
    "tooltip": true
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  muted",
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀  Wired",
    "format-disconnected": "⚠  Offline"
  },

  "cpu": {
    "interval": 1,
    "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "on-click": "kitty -e htop"
  },

  "memory": {
    "interval": 5,
    "format": "  {used:0.1f}G/{total:0.1f}G",
    "tooltip-format": "Memory"
  },
}
