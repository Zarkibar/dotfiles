configuration {
  show-icons: true;
  modes: "window,drun,run,ssh";
  font: "JetBrainsMono Nerd Font 14";

  drun-display-format: "{icon} {name}";

  display-ssh:    "󰣀 ssh:";
  display-run:    "󱓞 run:";
  display-drun:   "󰣖 drun:";
  display-window: "󱂬 window:";
  display-combi:  "󰕘 combi:";
  display-filebrowser: "󰉋 filebrowser:";

  modi: "window,run,drun,emoji";

  dpi: 120;

  timeout {
      action: "kb-cancel";
      delay:  0;
  }
  filebrowser {
      directories-first: true;
      sorting-method:    "name";
  }
}

@theme "theme"
