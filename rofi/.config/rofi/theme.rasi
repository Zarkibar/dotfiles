/**
 * theme.rasi — omarchy-inspired rofi theme
 * Palette: near-black ground, warm off-white type, muted sage accent
 * No borders, soft 5px radius, clean mono stack
 */

* {
    /* palette */
    bg:          #0f0f0f;
    bg-alt:      #171717;
    bg-sel:      #1e1e1e;
    fg:          #e8e3dc;
    fg-dim:      #6b6760;
    accent:      #8fa68e;     /* muted sage — the one warm breath of color */

    /* reset rofi defaults */
    background-color:  transparent;
    text-color:        @fg;
    border:            0px;
    margin:            0px;
    padding:           0px;
    spacing:           0px;
}

window {
    background-color:  @bg;
    border-radius:     5px;
    width:             620px;
    padding:           28px;
}

mainbox {
    spacing:     16px;
    children:    [ inputbar, listview ];
}

/* ── input ───────────────────────────────────────────────── */

inputbar {
    background-color:  @bg-alt;
    border-radius:     5px;
    padding:           13px 18px;
    spacing:           10px;
    children:          [ prompt, entry ];
}

prompt {
    text-color:   @accent;
    font:         "JetBrains Mono 13";
}

entry {
    placeholder:        "search…";
    placeholder-color:  @fg-dim;
    font:               "JetBrains Mono 13";
    cursor:             text;
}

/* ── list ────────────────────────────────────────────────── */

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    spacing:      3px;
}

element {
    border-radius:  5px;
    padding:        10px 18px;
    spacing:        12px;
    orientation:    horizontal;
    children:       [ element-icon, element-text ];
}

element normal.normal {
    background-color:  transparent;
    text-color:        @fg;
}

element normal.urgent {
    background-color:  transparent;
    text-color:        @fg-dim;
}

element normal.active {
    background-color:  transparent;
    text-color:        @accent;
}

element selected.normal {
    background-color:  @bg-sel;
    text-color:        @fg;
}

element selected.urgent {
    background-color:  @bg-sel;
    text-color:        @fg-dim;
}

element selected.active {
    background-color:  @bg-sel;
    text-color:        @accent;
}

element-icon {
    size:              20px;
    vertical-align:    0.5;
}

element-text {
    font:              "Inter 13";
    vertical-align:    0.5;
    highlight:         bold #8fa68e;
}

/* ── scrollbar ───────────────────────────────────────────── */

scrollbar {
    handle-color:      @fg-dim;
    handle-width:      3px;
    padding:           0px 2px;
}

/* ── message / error ─────────────────────────────────────── */

message {
    background-color:  @bg-alt;
    border-radius:     5px;
    padding:           10px 18px;
}

textbox {
    font:         "Inter 13";
    text-color:   @fg-dim;
}
